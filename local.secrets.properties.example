# Copy this file to `local.secrets.properties` and fill your real values.
# This file is the single source of truth for sensitive parameters.
# For external users, fill ONE credential set only.
# The demo currently keeps internal UAT/PROD key groups for testing compatibility.

# ---------- Unified credentials (recommended for users) ----------
# Keep these values consistent with the matching entries below.
TAPLINK_APP_ID=
TAPLINK_MERCHANT_ID=
TAPLINK_SECRET_KEY=
TAPLINK_CLOUD_BASE_URL=https://open.sunbay.us
TAPLINK_CLOUD_API_KEY=
TAPLINK_CLOUD_APP_ID=
TAPLINK_WEBHOOK_KEY=

# ---------- Internal compatibility mapping (used by current implementation) ----------
# PROD
PROD_CLOUD_BASE_URL=https://open.sunbay.us
PROD_CLOUD_API_KEY=
PROD_CLOUD_APP_ID=
PROD_WEBHOOK_KEY=
PROD_SDK_APP_ID=
PROD_SDK_MERCHANT_ID=
PROD_SDK_AUTH_KEY=

# UAT (optional; keep same values as PROD unless your support team provides separate test credentials)
UAT_CLOUD_BASE_URL=https://open.sunbay-uat.us
UAT_CLOUD_API_KEY=
UAT_CLOUD_APP_ID=
UAT_SDK_APP_ID=
UAT_SDK_MERCHANT_ID=
UAT_SDK_AUTH_KEY=

# APP (legacy app module)
APP_TAPLINK_APP_ID=
APP_TAPLINK_MERCHANT_ID=
APP_TAPLINK_SECRET_KEY=
